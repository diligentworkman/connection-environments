{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:watch": {
      "persistent": true,
      "cache": false
    },
    "test:ui": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^build", "^check"]
    },
    "dev": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false
    },
    "test-playground#dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "preview": {
      "dependsOn": ["build"]
    }
  }
}
